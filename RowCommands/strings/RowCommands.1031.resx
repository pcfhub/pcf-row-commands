  <data name="RowCommands_Name" xml:space="preserve">
    <value>Row Commands</value>
  </data>
  <data name="RowCommands_Desc" xml:space="preserve">
    <value>Open a record, launch a URL, or delete it with a confirm, from the row itself.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Datensätze</value>
  </data>
  <data name="UrlField_Name" xml:space="preserve">
    <value>URL-Spalte</value>
  </data>
  <data name="UrlField_Desc" xml:space="preserve">
    <value>Eine Spalte mit einer http- oder https-Adresse. Wird eine zugeordnet, erhält jede Zeile eine Schaltfläche „Öffnen“; ohne Zuordnung erscheint kein Linkbefehl.</value>
  </data>
  <data name="HideOpen_Name" xml:space="preserve">
    <value>Befehl „Öffnen“ ausblenden</value>
  </data>
  <data name="HideOpen_Desc" xml:space="preserve">
    <value>Entfernt die Schaltfläche „Öffnen“ aus jeder Zeile. Standardmäßig aus, damit Datensätze geöffnet werden können.</value>
  </data>
  <data name="ShowDelete_Name" xml:space="preserve">
    <value>Befehl „Löschen“ anzeigen</value>
  </data>
  <data name="ShowDelete_Desc" xml:space="preserve">
    <value>Fügt eine Schaltfläche „Löschen“ hinzu, die immer zuerst um Bestätigung bittet. Standardmäßig aus und auf Hosts ohne Dataverse nicht verfügbar.</value>
  </data>
  <data name="PageSize_Name" xml:space="preserve">
    <value>Seitengröße</value>
  </data>
  <data name="PageSize_Desc" xml:space="preserve">
    <value>Wie viele Zeilen pro Seite angefordert werden. Leer lassen, um die bereits von der App oder dem Benutzer gewählte Seitengröße zu verwenden; setzen, um sie zu überschreiben. Die Plattform kann große Werte begrenzen.</value>
  </data>
  <data name="InvokedRecordId_Name" xml:space="preserve">
    <value>ID des aufgerufenen Datensatzes</value>
  </data>
  <data name="InvokedRecordId_Desc" xml:space="preserve">
    <value>Die ID der Zeile, deren Befehl zuletzt ausgelöst wurde.</value>
  </data>
  <data name="InvokedCommand_Name" xml:space="preserve">
    <value>Aufgerufener Befehl</value>
  </data>
  <data name="InvokedCommand_Desc" xml:space="preserve">
    <value>Welcher Befehl ausgelöst wurde: open, url oder delete.</value>
  </data>
  <data name="InvokeCount_Name" xml:space="preserve">
    <value>Anzahl der Aufrufe</value>
  </data>
  <data name="InvokeCount_Desc" xml:space="preserve">
    <value>Wie viele Befehle ausgelöst wurden. Der Wert steigt bei jedem Auslösen, sodass zweimal derselbe Befehl zwei Ereignisse ergibt statt eines.</value>
  </data>
