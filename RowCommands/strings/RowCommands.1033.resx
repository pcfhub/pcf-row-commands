  <data name="RowCommands_Name" xml:space="preserve">
    <value>Row Commands</value>
  </data>
  <data name="RowCommands_Desc" xml:space="preserve">
    <value>Open a record, launch a URL, or delete it with a confirm, from the row itself.</value>
  </data>
  <data name="Records_DataSet_Name" xml:space="preserve">
    <value>Records</value>
  </data>
  <data name="UrlField_Name" xml:space="preserve">
    <value>URL column</value>
  </data>
  <data name="UrlField_Desc" xml:space="preserve">
    <value>A column holding an http or https address. Map one and every row gets a Launch button; leave it unmapped and no link command appears.</value>
  </data>
  <data name="HideOpen_Name" xml:space="preserve">
    <value>Hide the open command</value>
  </data>
  <data name="HideOpen_Desc" xml:space="preserve">
    <value>Removes the Open button from every row. Off by default, so records can be opened.</value>
  </data>
  <data name="ShowDelete_Name" xml:space="preserve">
    <value>Show the delete command</value>
  </data>
  <data name="ShowDelete_Desc" xml:space="preserve">
    <value>Adds a Delete button, which always asks for confirmation first. Off by default, and unavailable on hosts without Dataverse.</value>
  </data>
  <data name="PageSize_Name" xml:space="preserve">
    <value>Page size</value>
  </data>
  <data name="PageSize_Desc" xml:space="preserve">
    <value>How many rows to request per page. The platform may clamp large values.</value>
  </data>
  <data name="InvokedRecordId_Name" xml:space="preserve">
    <value>Invoked record ID</value>
  </data>
  <data name="InvokedRecordId_Desc" xml:space="preserve">
    <value>The ID of the row whose command was pressed most recently.</value>
  </data>
  <data name="InvokedCommand_Name" xml:space="preserve">
    <value>Invoked command</value>
  </data>
  <data name="InvokedCommand_Desc" xml:space="preserve">
    <value>Which command was pressed: open, url or delete.</value>
  </data>
  <data name="InvokeCount_Name" xml:space="preserve">
    <value>Invoke count</value>
  </data>
  <data name="InvokeCount_Desc" xml:space="preserve">
    <value>How many commands have been pressed. It increases on every press, so pressing the same command twice is two events rather than one.</value>
  </data>
